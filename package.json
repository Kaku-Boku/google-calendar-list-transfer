{
  "name": "google-calendar-list-transfer",
  "version": "0.1.0",
  "private": true,
  "description": "Project-local Google Apps Script development environment",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clasp": "node scripts/clasp.mjs",
    "gas:login": "node scripts/clasp.mjs login",
    "gas:logout": "node scripts/clasp.mjs logout",
    "gas:auth": "node scripts/clasp.mjs show-authorized-user",
    "gas:create": "node scripts/create-project.mjs",
    "gas:status": "node scripts/clasp.mjs show-file-status",
    "gas:pull": "node scripts/clasp.mjs pull",
    "gas:push": "npm run check && npm run check:config && node scripts/clasp.mjs push",
    "gas:deploy": "npm run check && npm run check:config && node scripts/clasp.mjs push -f && node scripts/deploy.mjs",
    "gas:deployments": "node scripts/clasp.mjs list-deployments",
    "gas:open-web": "node scripts/clasp.mjs open-web-app",
    "gas:open": "node scripts/clasp.mjs open-script",
    "gas:mcp": "node scripts/clasp.mjs mcp",
    "check": "tsc --project jsconfig.json --noEmit",
    "check:config": "node scripts/check-config.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "setup:codex": "node scripts/setup-codex.mjs",
    "manual:prepare": "node scripts/manual/prepare.mjs",
    "manual:shots": "node scripts/manual/shots.mjs",
    "manual:pdf": "node scripts/manual/pdf.mjs",
    "manual": "npm run manual:prepare && npm run manual:shots && npm run manual:pdf"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/biz-udpgothic": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.12",
    "pagedjs": "0.4.3",
    "puppeteer-core": "25.11.0",
    "qrcode": "1.5.4",
    "typescript": "7.0.2"
  }
}
