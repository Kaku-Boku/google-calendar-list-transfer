{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleDetection": "legacy",
    "lib": ["ES2020"],
    "types": ["google-apps-script"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", ".local", ".cache", "src/LocalConfig.js"]
}
